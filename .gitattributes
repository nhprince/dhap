# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Explicit text file formats
*.rs text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.html text eol=lf
*.css text eol=lf
*.svg text eol=lf

# Explicit binary files
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.mp4 binary
*.mov binary
*.webm binary
*.pdf binary
*.docx binary
*.dhap binary
*.ico binary
